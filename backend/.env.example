# Application
APP_NAME=TallerAI API
ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://tallerai:tallerai@localhost:5432/tallerai

# Reserved for the authentication phase. Change this value in every environment.
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI providers are intentionally disabled in this phase. When a provider is enabled,
# keep its credentials here or in the deployment secret manager, never in source code.
AI_PROVIDER=stub
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=30
VISION_API_KEY=
TRANSCRIPTION_API_KEY=
KNOWLEDGE_API_KEY=

#Database docker
DATABASE_URL=postgresql+psycopg://tallerai:tallerai@localhost:5432/tallerai